# 服务配置
NODE_ENV=development
PORT=3000

# JWT 密钥（请修改为强随机字符串）
JWT_SECRET=your-super-secret-key-change-this-in-production

# 数据库路径
DB_PATH=../data/blog.db

# 上传配置
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# CORS 配置
CORS_ORIGIN=http://localhost:5173

# 站点基础 URL（sitemap 生成使用；建议生产配置为 https://your-domain.com，避免 Host 头注入）
SITE_URL=

# 反向代理（Nginx/宝塔反代时用于正确识别客户端 IP）
# 注意：TRUST_PROXY=1 必须配合 Nginx「覆盖式」转发头：
#   proxy_set_header X-Forwarded-For $remote_addr;
# 若用 $proxy_add_x_forwarded_for（追加模式），req.ip 会取到客户端可伪造的最左值，
# 登录限流/浏览防刷将被绕过。更稳妥的写法是只信任本机代理：
#   TRUST_PROXY=127.0.0.1   （支持逗号分隔多个代理 IP）
TRUST_PROXY=1
