# 服务配置
NODE_ENV=development
PORT=3000

# JWT 密钥（请修改为强随机字符串）
JWT_SECRET=your-super-secret-key-change-this-in-production

# 数据库路径
DB_PATH=../data/blog.db

# 上传配置
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# CORS 配置
CORS_ORIGIN=http://localhost:5173

# 站点基础 URL（sitemap 生成使用；建议生产配置为 https://your-domain.com，避免 Host 头注入）
SITE_URL=

# 反向代理（Nginx/宝塔反代时设为 1，用于正确识别客户端 IP）
TRUST_PROXY=1
